[Unit]
Description=Blomp rclone mount
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/rclone mount blompbox: %h/blomp --vfs-cache-mode full --vfs-cache-max-size 5G --vfs-write-back 10s --transfers 2 --tpslimit 4
ExecStop=/usr/bin/fusermount3 -u %h/blomp
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
