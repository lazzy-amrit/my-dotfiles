{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.txt", // Point to your ASCII file
        "padding": {
            "top": 2,
            "right": 6
        },
        "color": {
            "1": "cyan" // Matches the teal/cyan look
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan",
            "title": "white"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "break",
        { "type": "os", "key": "󰣇 OS", "keyColor": "cyan" },
        { "type": "kernel", "key": "󰒋 Kernel", "keyColor": "cyan" },
        { "type": "uptime", "key": "󱎫 Uptime", "keyColor": "cyan" },
        { "type": "packages", "key": "󰏖 Pkgs", "keyColor": "cyan" },
        { "type": "shell", "key": "󱆃 Shell", "keyColor": "cyan" },
        { "type": "wm", "key": "󱂬 WM", "keyColor": "cyan" },
        { "type": "cpu", "key": "󰻠 CPU", "keyColor": "cyan" },
        { "type": "gpu", "key": "󰢮 GPU", "keyColor": "cyan" },
        { "type": "memory", "key": "󰍛 RAM", "keyColor": "cyan" }
    ]
}
