[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 100
    origin = top-right
    offset = 15x40
    scale = 0
    notification_limit = 4

    progress_bar = true
    progress_bar_height = 6

    transparency = 0
    corner_radius = 10
    frame_width = 0

    gap_size = 8

    font = monospace 9

    format = "<b>%s</b>\n%b"
    alignment = left

    show_age_threshold = 60
    word_wrap = yes

    idle_threshold = 120

    background = "#000000cc"
    foreground = "#e6e6e6"

    separator_height = 0
    padding = 10
    horizontal_padding = 10

    sort = yes
    shrink = yes

    indicate_hidden = yes
